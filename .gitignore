# PlatformIO
.pio/

# Generierter, vollstaendig aufgeloester sdkconfig-Cache.
# Wird aus sdkconfig.defaults erzeugt; einchecken fuehrt zu genau der Drift,
# die in docs/content/history.md mehrfach Zeit gekostet hat.
sdkconfig.wt32-eth01
sdkconfig.wt32-eth01-minimal
sdkconfig.*.old

# Build-Artefakte und Vergleichs-Images.
# Die Rust-Vergleichsfirmware wurde mit einkompilierten WLAN-Zugangsdaten
# gebaut - gehoert unter keinen Umstaenden in ein oeffentliches Repo.
vergleich/
*.bin
*.elf

# Von scripts/gen_build_info.py vor jedem Build neu geschrieben.
src/build_info.h

# Von scripts/ota_flash.sh archivierte firmware.elf-Dateien (siehe *.elf
# oben - hier nur der Ordner, aus Dokumentationsgruenden explizit).
elf_archive/

# Aus der Arduino-Zeit uebrig, wird nicht mehr gelesen
dependencies.lock

.DS_Store
