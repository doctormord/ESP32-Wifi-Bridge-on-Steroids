# PlatformIO
.pio/

# Generated, fully resolved sdkconfig cache.
# Produced from sdkconfig.defaults; committing it causes exactly the drift
# that is described in CLAUDE.md ("sdkconfig drift").
sdkconfig.wt32-eth01
sdkconfig.wt32-eth01-minimal
sdkconfig.*.old

# Build artifacts and comparison images.
# The comparison firmware in this folder was built with Wi-Fi credentials
# compiled in - it must never end up in a public repository. (The folder
# name is kept as is so the existing local directory stays ignored.)
vergleich/
*.bin
*.elf

# Rewritten by scripts/gen_build_info.py before every build.
src/build_info.h

# firmware.elf files archived by scripts/ota_flash.sh (already covered by
# *.elf above - the folder is listed explicitly for documentation).
elf_archive/

# Leftover from the Arduino era, no longer read
dependencies.lock

.DS_Store
