# ============================================================================
#  sdkconfig.defaults.esp32c5  -  nur fuer das Ziel ESP32-C5
# ============================================================================
#  ESP-IDF laedt diese Datei automatisch ZUSAETZLICH zu sdkconfig.defaults,
#  wenn IDF_TARGET=esp32c5 ist (env:nicemcu-c5-w5500). Hier steht nur, was
#  sich vom WT32-ETH01 unterscheidet; alles andere gilt gemeinsam.
#
#  Die CONFIG_ETH_DMA_*-Zeilen aus sdkconfig.defaults betreffen nur den
#  internen EMAC des klassischen ESP32. Den hat der C5 nicht - Kconfig
#  ignoriert sie hier (Warnung "unknown kconfig symbol" beim Build ist normal).

# --- Ethernet: W5500 an SPI statt EMAC + LAN8720 ----------------------------
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_ETH_SPI_ETHERNET_DM9051=n
CONFIG_ETH_SPI_ETHERNET_KSZ8851SNL=n

# Der W5500-Treiber spricht pro Frame mehrfach per spi_device_polling_transmit
# mit dem Chip (Groesse lesen, Kopf, Nutzdaten, Lesezeiger, RECV-Kommando).
# Diese Pfade ins IRAM statt per Cache aus dem Flash - bei 80 MHz SPI ist die
# Software-Strecke zwischen den Transfers ein spuerbarer Teil der Zeit.
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# --- CPU --------------------------------------------------------------------
# Das ESP32-Symbol CONFIG_ESP32_DEFAULT_CPU_FREQ_240 aus sdkconfig.defaults
# gilt hier nicht; der C5 kann ebenfalls 240 MHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- Flash ------------------------------------------------------------------
# board_build.flash_size allein kam beim ersten Build nicht in der Kconfig an
# ("Expected 4MB, found 2MB"). Hier explizit, passend zum im Chip verbauten
# 4-MB-Flash des C5HF4 und zu partitions_4mb_ota.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
